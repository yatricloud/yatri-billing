# Yatri Billing Environment Variables
# Copy this file to .env and configure your values:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your .env file or real credentials to Git.
# 2. ONLY use your public anon/publishable key for SUPABASE_ANON_KEY.
# 3. NEVER put your service_role secret key here — service_role keys bypass RLS
#    and will be automatically rejected by the client security validator.

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Supabase Public Anon Key (JWT token with role: "anon")
SUPABASE_ANON_KEY=
